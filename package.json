{
  "name": "firewatch",
  "version": "0.1.0",
  "description": "Node.js API that polls JAXA Himawari WLF fire hotspots for Indonesia every 10 minutes",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate": "node src/db/migrate.js",
    "ingest:once": "node src/ingest/runOnce.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "basic-ftp": "^5.0.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1"
  }
}
