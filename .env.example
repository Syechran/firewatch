# Server
PORT=3000
HOST=0.0.0.0

# PostgreSQL
DATABASE_URL=postgres://firewatch:firewatch@localhost:5432/firewatch

# JAXA P-Tree FTP (free account: https://www.eorc.jaxa.jp/ptree/)
# Do not commit real credentials. Copy this file to .env and fill in.
PTREE_HOST=ftp.ptree.jaxa.jp
PTREE_USER=your_registered_email@example.com
PTREE_PASSWORD=your_ptree_password

# Himawari Wild Fire (WLF) product
# Algorithm version directory under /pub/himawari/L2/WLF/
WLF_VERSION=010
# Top-level FTP path (usually /pub)
PTREE_ROOT=/pub

# Indonesia bounding box: minLon,minLat,maxLon,maxLat
INDONESIA_BBOX=94.5,-11.5,141.5,6.5

# Ingest
# How far back to scan on each cycle (minutes). Covers missed runs and publish lag.
INGEST_LOOKBACK_MINUTES=180
# Cron for the 10-minute poll (UTC). Offset ~2 min after the :00/:10/... slot.
INGEST_CRON=2,12,22,32,42,52 * * * *
# Set to 1 to skip the scheduler (useful for one-shot/manual runs)
DISABLE_SCHEDULER=0
